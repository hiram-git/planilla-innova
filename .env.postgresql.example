# ============================================
# CONFIGURACIÓN POSTGRESQL - EJEMPLO
# ============================================
# Copiar las variables necesarias a tu archivo .env
# para habilitar PostgreSQL en tu instalación

# ============================================
# OPCIÓN 1: Migrar completamente a PostgreSQL
# ============================================
# Cambia la conexión por defecto a PostgreSQL
DB_CONNECTION=pgsql

# ============================================
# OPCIÓN 2: Usar PostgreSQL solo para tenants específicos
# ============================================
# Mantén DB_CONNECTION=mysql y configura las variables PGSQL_*
# Luego configura cada tenant individualmente

# ============================================
# CONFIGURACIÓN BASE DE DATOS PRINCIPAL
# ============================================

# PostgreSQL - Tenant Database (base de datos de cada empresa)
PGSQL_HOST=localhost
PGSQL_PORT=5432
PGSQL_DATABASE=planilla_prod
PGSQL_USERNAME=postgres
PGSQL_PASSWORD=tu_password_aqui
PGSQL_SCHEMA=public
PGSQL_SSLMODE=prefer

# ============================================
# CONFIGURACIÓN MASTER DATABASE (Multi-tenancy)
# ============================================

# Driver para Master DB: 'mysql' o 'pgsql'
MASTER_DB_DRIVER=pgsql

# PostgreSQL - Master Database (planilla_master)
MASTER_DB_HOST=localhost
MASTER_DB_PORT=5432
MASTER_DB_NAME=planilla_master
MASTER_DB_USER=postgres
MASTER_DB_PASS=tu_password_aqui
MASTER_DB_CHARSET=utf8
MASTER_DB_SCHEMA=public
MASTER_DB_SSLMODE=prefer

# ============================================
# NOTAS IMPORTANTES
# ============================================

# 1. SSL Mode en PostgreSQL:
#    - disable: Sin SSL
#    - prefer: Intenta SSL, si falla usa conexión normal (default)
#    - require: Requiere SSL obligatorio
#    - verify-ca: Requiere SSL y verifica certificado
#    - verify-full: Requiere SSL y verifica certificado + hostname

# 2. Schema en PostgreSQL:
#    - Por defecto es 'public'
#    - Puedes crear schemas separados para organizar tablas

# 3. Puerto por defecto:
#    - PostgreSQL: 5432
#    - MySQL: 3306

# 4. Usuario por defecto:
#    - PostgreSQL: postgres
#    - MySQL: root

# 5. Charset:
#    - PostgreSQL: utf8 (no soporta utf8mb4)
#    - MySQL: utf8mb4

# ============================================
# MIGRACIÓN PROGRESIVA
# ============================================

# Escenario A: Mantener MySQL para todo excepto master DB
# DB_CONNECTION=mysql
# MASTER_DB_DRIVER=pgsql

# Escenario B: Migrar todo a PostgreSQL
# DB_CONNECTION=pgsql
# MASTER_DB_DRIVER=pgsql

# Escenario C: Mantener todo en MySQL (actual)
# DB_CONNECTION=mysql
# MASTER_DB_DRIVER=mysql
# (o simplemente no definir estas variables)

# ============================================
# EJEMPLO COMPLETO PARA PRODUCCIÓN
# ============================================

